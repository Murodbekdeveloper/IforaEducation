# Prisma connection string (PostgreSQL). Leave empty for now — the API
# automatically falls back to in-memory demo data when this is unset or
# unreachable. Fill it in once the real database is provisioned, then run:
#   npx prisma migrate dev --name init
#   npx prisma db seed
DATABASE_URL=""

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:3000"

# Port the NestJS API listens on
PORT=4100

# Secret used to sign student login sessions (JWT). Keep this private.
JWT_SECRET="replace-with-a-long-random-string"

# Card shown on the payment page for direct P2P bank transfers.
PAYMENT_CARD_NUMBER=""
PAYMENT_CARD_HOLDER=""
PAYMENT_CARD_EXPIRY=""
